
input {
    keyboard {
        xkb {
            layout "gb"
            // options "grp:win_space_toggle,compose:ralt,ctrl:nocaps"
            // localectl set-x11-keymap gb
        }
        numlock     // Enable numlock on startup, omitting this setting disables it.
    }
    touchpad {
        // off
        tap
        // dwt
        // dwtp
        // drag false
        // drag-lock
        natural-scroll
        // accel-speed 0.2
        // accel-profile "flat"
        // scroll-method "two-finger"
        // disabled-on-external-mouse
    }
    mouse {
        // off
        // natural-scroll
        // accel-speed 0.2
        // accel-profile "flat"
        // scroll-method "no-scroll"
    }
    trackpoint {
        // off
        // natural-scroll
        // accel-speed 0.2
        // accel-profile "flat"
        // scroll-method "on-button-down"
        // scroll-button 273
        // scroll-button-lock
        // middle-emulation
    }
    // warp-mouse-to-focus
    // focus-follows-mouse max-scroll-amount="0%"
}

layout {
    // Set gaps around windows in logical pixels.
    gaps 16
    center-focused-column "never"               // "never" "always" "on-overflow"
    preset-column-widths {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
        // fixed 1920                           // Fixed sets the width in logical pixels exactly.
    }
    preset-window-heights { }

    default-column-width { proportion 0.5; }    // If you leave the brackets empty, the windows themselves will decide their initial width.

    focus-ring {
        // off
        width 4
        active-color "#7fc8ff"
        inactive-color "#505050"
        // active-gradient from="#80c8ff" to="#c7ff7f" angle=45
        // inactive-gradient from="#505050" to="#808080" angle=45 relative-to="workspace-view"
    }
    border {
        off
        width 4
        active-color "#ffc87f"
        inactive-color "#505050"
        urgent-color "#9b0000"
        // active-gradient from="#e5989b" to="#ffb4a2" angle=45 relative-to="workspace-view" in="oklch longer hue"
        // inactive-gradient from="#505050" to="#808080" angle=45 relative-to="workspace-view"
    }

    // You can enable drop shadows for windows.
    shadow {
        // Uncomment the next line to enable shadows.
        // on
        // Softness controls the shadow blur radius.
        softness 30
        // Spread expands the shadow.
        spread 5
        // Offset moves the shadow relative to the window.
        offset x=0 y=5
        // You can also change the shadow color and opacity.
        color "#0007"
    }

    // Struts shrink the area occupied by windows, similarly to layer-shell panels.
    // You can think of them as a kind of outer gaps. They are set in logical pixels.
    // Left and right struts will cause the next window to the side to always be visible.
    // Top and bottom struts will simply add outer gaps in addition to the area occupied by
    // layer-shell panels and regular gaps.
    struts {
        // left 64
        // right 64
        // top 64
        // bottom 64
    }
}

spawn-at-startup "waybar"
// spawn-sh-at-startup "" run start up scripts im this, arguement is command to run i.e bash script.sh

hotkey-overlay {
    skip-at-startup
}

screenshot-path "~/Pictures/Screenshots/Screenshot from %Y-%m-%d %H-%M-%S.png"

animations {
    slowdown 2.0
}

window-rule {
    match app-id=r#"firefox$"# title="^Picture-in-Picture$"
    open-floating true
}


binds {

    // Special \\
    Mod+Shift+Slash { show-hotkey-overlay; }    // Open Hot Key List
    Print           { screenshot; }             //                                                       
    Ctrl+Print      { screenshot-screen; }      //
    Alt+Print       { screenshot-window; }      //

    // == App Shortcuts ==\\
    Mod+Return hotkey-overlay-title="Open Terminal" { spawn "konsole"; }                                        // Open Terminal
    Mod+Shift+Return hotkey-overlay-title="Open Launcher: wofi" { spawn-sh "wofi --show drun"; }                 // Open Launcher
    Mod+B hotkey-overlay-title="Run an Application: Browser" { spawn "firefox"; }                               // Open Browser
    Mod+E hotkey-overlay-title="Open Dolphin" { spawn-sh "dolphin --new-window"; }                              // Open File Explorer

    // == Sound == \\
    XF86AudioRaiseVolume allow-when-locked=true { spawn-sh "wpctl set-volume @DEFAULT_AUDIO_SINK@ 0.1+"; }      // Vol Up
    XF86AudioLowerVolume allow-when-locked=true { spawn-sh "wpctl set-volume @DEFAULT_AUDIO_SINK@ 0.1-"; }      // Vol Down
    XF86AudioMute        allow-when-locked=true { spawn-sh "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"; }      // Mute Sound       
    XF86AudioMicMute   allow-when-locked=true { spawn-sh "wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle"; }      // Mute Mic

    // == Screen Brightness == \\
    XF86MonBrightnessUp allow-when-locked=true { spawn "brightnessctl" "--class=backlight" "set" "+10%"; }      // Screen Brightness Up
    XF86MonBrightnessDown allow-when-locked=true { spawn "brightnessctl" "--class=backlight" "set" "10%-"; }    // Screen Brightness Down

    // == Window Control & Navigation == \\
    Mod+W repeat=false { toggle-overview; }                     // Toggle Windows & Workspace View
    Mod+Shift+W { toggle-column-tabbed-display; }               // Toggle Stack Windows in Column
    Mod+T       { toggle-window-floating; }                     // Toggle Current Window Floating
    Mod+Shift+T { switch-focus-between-floating-and-tiling; }   // Toggle All Windows Floating
    Mod+Q repeat=false { close-window; }                        // Close Window
    // --> Reize Window
    Mod+Minus       { set-column-width "-10%"; }                // Decrease Column Width
    Mod+Equal       { set-column-width "+10%"; }                // Increase Column Width
    Mod+Shift+Minus { set-window-height "-10%"; }               // Decrease Column Height
    Mod+Shift+Equal { set-window-height "+10%"; }               // Increase Column Height
    Mod+R           { switch-preset-column-width; }             // Cycle Present Widths
    Mod+Shift+R     { switch-preset-window-height; }            // Cycle Present Heights
    Mod+Ctrl+R      { reset-window-height; }                    // Reset Height
    Mod+F           { maximize-column; }                        // Maximize Column
    Mod+Shift+F     { fullscreen-window; }                      // Fullscreen Focused Window
    Mod+Ctrl+F      { expand-column-to-available-width; }       // Expand Column to Max   
    Mod+C           { center-column; }                          // Center Column
    Mod+Ctrl+C      { center-visible-columns; }                 // Column All Visible Columns
    // --> Change Window/Column Focus           
    Mod+Left  { focus-column-left; }                            // Focus Window Left 
    Mod+Down  { focus-window-down; }                            // Focus Window Below
    Mod+Up    { focus-window-up; }                              // Focus Window Above
    Mod+Right { focus-column-right; }                           // Focus Window Right
    Mod+H     { focus-column-left; }                            // Focus Window Left
    Mod+J     { focus-window-down; }                            // Focus Window Below
    Mod+K     { focus-window-up; }                              // Focus Window Above
    Mod+L     { focus-column-right; }                           // Focus Window Right
    Mod+Home  { focus-column-first; }                           // Focus First Column
    Mod+End   { focus-column-last; }                            // Focus Last Column   
    // --> Move Focused Window/Column           
    Mod+Shift+Left   { move-column-left; }                       // Move Window Left One Column
    Mod+Shift+Down   { move-window-down; }                       // Move Window Down One Workspace
    Mod+Shift+Up     { move-window-up; }                         // Move Window Up One Workspace
    Mod+Shift+Right  { move-column-right; }                      // Move Window Right One Column
    Mod+Shift+H      { move-column-left; }                       // Move Window Left One Column
    Mod+Shift+J      { move-window-down; }                       // Move Window Down One Workspace
    Mod+Shift+K      { move-window-up; }                         // Move Window Up One Workspace
    Mod+Shift+L      { move-column-right; }                      // Move Window Right One Column
    Mod+Ctrl+Home    { move-column-to-first; }                   // Move Window to First Column
    Mod+Ctrl+End     { move-column-to-last; }                    // Move Window to Last Column
    Mod+Comma        { consume-or-expel-window-left; }           // Merge/Unmerge Focused Window into Column Left
    Mod+Period       { consume-or-expel-window-right; }          // Merge/Unmerge Focused Window into Column Right
    Mod+BracketLeft  { consume-window-into-column; }             // Merge Focused Window into Column
    Mod+BracketRight { expel-window-from-column; }               // Unmerge Focused Window into Column
    // == Monitor Control & Navigation == \\
    // --> Change Monitor Focus
    Mod+Ctrl+Alt+Left  { focus-monitor-left; }                   // Focus Monitor Left               
    Mod+Ctrl+Alt+Down  { focus-monitor-down; }                   // Focus Monitor Below
    Mod+Ctrl+Alt+Up    { focus-monitor-up; }                     // Focus Monitor Above
    Mod+Ctrl+Alt+Right { focus-monitor-right; }                  // Focus Monitor Right
    Mod+Ctrl+Alt+H     { focus-monitor-left; }                   // Focus Monitor Left
    Mod+Ctrl+Alt+J     { focus-monitor-down; }                   // Focus Monitor Below
    Mod+Ctrl+Alt+K     { focus-monitor-up; }                     // Focus Monitor Above
    Mod+Ctrl+Alt+L     { focus-monitor-right; }                  // Focus Monitor Right
    // --> Move Window/Column to Monitor
    Mod+Alt+Shift+Left  { move-column-to-monitor-left; }         // Move Column To Monitor Left
    Mod+Alt+Shift+Down  { move-column-to-monitor-down; }         // Move Column To Monitor Below
    Mod+Alt+Shift+Up    { move-column-to-monitor-up; }           // Move Column To Monitor Above
    Mod+Alt+Shift+Right { move-column-to-monitor-right; }        // Move Column To Monitor Right
    Mod+Alt+Shift+H     { move-column-to-monitor-left; }         // Move Column To Monitor Left
    Mod+Alt+Shift+J     { move-column-to-monitor-down; }         // Move Column To Monitor Below
    Mod+Alt+Shift+K     { move-column-to-monitor-up; }           // Move Column To Monitor Above
    Mod+Alt+Shift+L     { move-column-to-monitor-right; }        // Move Column To Monitor Right

    // == Workspace Control & Navigation == \\
    // --> Change Workspace Focus
    Mod+Tab { focus-workspace-previous; }                        //   Focus Previous Workspace
    Mod+Ctrl+Down     { focus-workspace-down; }                  //   Focus Workspace Below 
    Mod+Ctrl+Up       { focus-workspace-up; }                    //   Focus Workspace Above
    Mod+Ctrl+J        { focus-workspace-down; }                  //   Focus Workspace Below
    Mod+Ctrl+K        { focus-workspace-up; }                    //   Focus Workspace Above
    Mod+1             { focus-workspace 1; }                     // \
    Mod+2             { focus-workspace 2; }                     // |
    Mod+3             { focus-workspace 3; }                     // |
    Mod+4             { focus-workspace 4; }                     // | Focus Workspace X
    Mod+5             { focus-workspace 5; }                     // |
    Mod+6             { focus-workspace 6; }                     // |
    Mod+7             { focus-workspace 7; }                     // |
    Mod+8             { focus-workspace 8; }                     // |
    Mod+9             { focus-workspace 9; }                     // /
    // --> Move Workspace
    Mod+Shift+Page_Down { move-workspace-down; }                 //    Move Workspace Down
    Mod+Shift+Page_Up   { move-workspace-up; }                   //    Move Workspace Up
    Mod+Shift+U         { move-workspace-down; }                 //    Move Workspace Down
    Mod+Shift+I         { move-workspace-up; }                   //    Move Workspace Up
    // --> Move Column to Workspace
    Mod+Ctrl+Shift+Down     { move-column-to-workspace-down; }   //    Move Column to Workspace Below
    Mod+Ctrl+Shift+Up       { move-column-to-workspace-up; }     //    Move Column to Workspace Above   
    Mod+Ctrl+Shift+J        { move-column-to-workspace-down; }   //    Move Column to Workspace Below
    Mod+Ctrl+Shift+K        { move-column-to-workspace-up; }     //    Move Column to Workspace Above
    Mod+Shift+1             { move-column-to-workspace 1; }      // \
    Mod+Shift+2             { move-column-to-workspace 2; }      // |
    Mod+Shift+3             { move-column-to-workspace 3; }      // |
    Mod+Shift+4             { move-column-to-workspace 4; }      // | Move Column to Workspace X
    Mod+Shift+5             { move-column-to-workspace 5; }      // |
    Mod+Shift+6             { move-column-to-workspace 6; }      // |
    Mod+Shift+7             { move-column-to-workspace 7; }      // |
    Mod+Shift+8             { move-column-to-workspace 8; }      // |
    Mod+Shift+9             { move-column-to-workspace 9; }      // /    

    // == Mouse Control & Navigation == \\
    Mod+WheelScrollDown      cooldown-ms=150 { focus-workspace-down; }
    Mod+WheelScrollUp        cooldown-ms=150 { focus-workspace-up; }
    Mod+Ctrl+WheelScrollDown cooldown-ms=150 { move-column-to-workspace-down; }
    Mod+Ctrl+WheelScrollUp   cooldown-ms=150 { move-column-to-workspace-up; }

    Mod+WheelScrollRight      { focus-column-right; }
    Mod+WheelScrollLeft       { focus-column-left; }
    Mod+Ctrl+WheelScrollRight { move-column-right; }
    Mod+Ctrl+WheelScrollLeft  { move-column-left; }

    Mod+Shift+WheelScrollDown      { focus-column-right; }
    Mod+Shift+WheelScrollUp        { focus-column-left; }
    Mod+Ctrl+Shift+WheelScrollDown { move-column-right; }
    Mod+Ctrl+Shift+WheelScrollUp   { move-column-left; }













}
