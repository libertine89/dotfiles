## RSync (Move and Copy with progress bars & confirmations)
mvv() {
  rsync -ah --info=progress2 --interactive --remove-source-files "$@"
  for src in "$@"; do
    [ -d "$src" ] && find "$src" -type d -empty -delete
  done
}
cpv(){
  rsync -ah --info=progress2 --interactive
}
# -----------------------------------------------------
# Package Managers
# -----------------------------------------------------
## Apt
aptin() { sudo apt install "$@"; }
aptup() { sudo apt update && sudo apt upgrade; }
aptd() { sudo apt update; }
aptg() { sudo apt upgrade; }
aptrm() { sudo apt remove "$@"; }
## Pacman
pacman() { command sudo pacman -S "$@"; }
pacup() { sudo pacman -Syu; }             # Update & Upgrade
pacd() { sudo pacman -Sy; }               # Update Pacman
pacg() { sudo pacman -Su; }               # Upgrade packages
pacrm() { sudo pacman -Rns "$@"; }
## AUR
yay() { command yay -S "$@"; }
yayup() { yay -Syu; }                     # Update & Upgrade
yayd() { yay -Sy; }                       # Update AUR & Pacman
yayg() { yay -Su; }                       # Upgrade packages
yayrm() { yay -Rns "$@"; }

# -----------------------------------------------------
# Git
# -----------------------------------------------------
alias gs="git status"
alias gr="git remote -v"
alias ga="git add"
alias gc="git commit -m"
alias gp="git push"
alias gpl="git pull"
alias gst="git stash"
alias gsp="git stash; git pull"
alias gfo="git fetch origin"
alias gcheck="git checkout"
alias gcredential="git config credential.helper store"

push() {
  local base="/home/$USER/Git"
  local msg="${@: -1}"

  if [ "$#" -eq 1 ]; then
    # current repo mode
    git add .
    git commit -m "$msg"
    git push
  else
    local repos=("${@:1:$#-1}")
    for repo in "${repos[@]}"; do
      if [ -d "$base/$repo/.git" ]; then
        echo "Pushing in $repo..."
        (
          cd "$base/$repo" || exit
          git add .
          git commit -m "$msg"
          git push
        )
      else
        echo "⚠️ Skipping $repo (not found or not a git repo)"
      fi
    done
  fi
}

pull() {
  local base="/home/$USER/Git"
  local repos=()
  local git_args=()

  # Split args into repo names and git pull flags
  for arg in "$@"; do
    if [[ "$arg" == -* ]]; then
      git_args+=("$arg")
    else
      repos+=("$arg")
    fi
  done

  if [ "${#repos[@]}" -eq 0 ]; then
    # current repo mode
    git pull "${git_args[@]}" || {
      echo "⚠️ Pull failed in current repo. Resolve conflicts and press Enter to continue..."
      read -r
    }
  else
    for repo in "${repos[@]}"; do
      if [ -d "$base/$repo/.git" ]; then
        echo "Pulling in $repo..."
        (
          cd "$base/$repo" || exit
          git pull "${git_args[@]}" || {
            echo "⚠️ Pull failed in $repo. Resolve conflicts and press Enter to continue..."
            read -r
          }
        )
      else
        echo "⚠️ Skipping $repo (not found or not a git repo)"
      fi
    done
  fi
}

